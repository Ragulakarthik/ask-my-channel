# Copy to .env and fill in, then `export $(grep -v '^#' .env | xargs)` before running,
# or pass the same values as normal environment variables / -D system properties.

GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Gates /profile.html and ingestion — pick anything only you know. Leave unset and those
# actions fail closed (rejected) rather than being left wide open.
PROFILE_PASSPHRASE=pick-something-only-you-know

# Only needed if you want to override the defaults (which already match docker-compose.yml):
# DB_URL=jdbc:postgresql://localhost:5433/ask_my_channel
# DB_USERNAME=askmychannel
# DB_PASSWORD=askmychannel
# YT_DLP_PATH=yt-dlp
